# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas cluster or local mongodb://127.0.0.1:27017/portfolio)
MONGODB_URI=

# Recipient email for contact form submissions
CONTACT_TO_EMAIL=kamblegaurav193@gmail.com

# Gmail SMTP Configuration (Optional: Create an App Password at myaccount.google.com/apppasswords)
SMTP_USER=kamblegaurav193@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
