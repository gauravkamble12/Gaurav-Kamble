# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=5000

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=kamblegaurav193@gmail.com

# The address the mail is sent FROM.
# Must be a real Gmail account, and usually must match SMTP_USER.
SMTP_USER=kamblegaurav193@gmail.com

# Gmail App Password (NOT your normal password).
# Enable 2FA on the Google account, then create one at:
# https://myaccount.google.com/apppasswords
# It is a 16-character string with no spaces, e.g. abcd efgh ijkl mnop -> "abcdefghijklmnop"
SMTP_PASS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Comma-separated list of origins allowed to call this API.
# Use the deployed site URL in production, e.g. https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limit: max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
